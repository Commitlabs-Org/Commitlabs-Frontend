# Public, build-time configuration (inlined by Next.js at build time; changing requires a rebuild)
# Supported networks: testnet | futurenet | mainnet
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Optional overrides (must use https: protocol)
# Defaults to network-specific endpoints when unset
# NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
# NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Soroban escrow contract ID (optional, 56-char C... address; demo mode used if unset)
NEXT_PUBLIC_ESCROW_CONTRACT_ID=CBPNVNWDFZOUNB6REHBPGU2DRP4AJSVS7QJ3SEOUIDBTW6DZEHQKJ5E4
