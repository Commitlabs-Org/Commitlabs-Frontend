{
  "name": "commitlabs-frontend",
  "version": "0.2.0",
  "private": true,
  "description": "CommitLabs - liquidity as a commitment on Stellar Soroban",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node api.js && next dev",
    "prebuild": "node scripts/validate-env.mjs",
    "build": "node api.js && next build",
    "analyze": "cross-env ANALYZE=true next build",
    "start": "node api.js && next start",
    "typecheck": "tsc --noEmit",
    "circular": "madge --circular --extensions ts,tsx src",
    "size": "node scripts/check-bundle-budget.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:size": "node --test scripts/check-bundle-budget.test.mjs"
  },
  "dependencies": {
    "@stellar/freighter-api": "^1.7.1",
    "@stellar/stellar-sdk": "^17.2.1",
    "next": "14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@next/bundle-analyzer": "^14.2.35",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20.19.33",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "^4.10.2",
    "cross-env": "^10.1.0",
    "jsdom": "^26.1.0",
    "madge": "^8.0.0",
    "typescript": "^5.6.3",
    "vitest": "^3.2.7",
    "vitest-axe": "^0.1.0"
  }
}
