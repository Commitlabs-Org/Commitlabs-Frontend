+}
+
+export interface EarlyExitCommitmentOnChainResult {
+  exitAmount: string;
+  penaltyAmount: string;
+  finalStatus: string;
+  txHash?: string;
+  reference?: string;
+}
+
+export interface FundEscrowOnChainParams {
